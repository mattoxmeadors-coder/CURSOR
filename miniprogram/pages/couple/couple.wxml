<!-- 情侣通关 · 剧本杀版 -->
<view class="couple-page">

  <!-- ═══ 落地页 ═══ -->
  <view wx:if="{{pageState === 'landing'}}" class="landing">
    <view class="landing-bg-text">不翻车</view>

    <view class="landing-hero">
      <view class="landing-eyebrow">情侣通关</view>
      <view class="landing-title">你们真的是一队吗</view>
      <view class="landing-sub">各自作答，不能看对方\n最后同时揭晓——你们到底差在哪</view>
    </view>

    <view class="scene-preview">
      <view class="scene-item">
        <text class="scene-num">01</text>
        <text class="scene-name">出租车里</text>
        <text class="scene-dot">暗号</text>
      </view>
      <view class="scene-arrow">→</view>
      <view class="scene-item">
        <text class="scene-num">02</text>
        <text class="scene-name">进门那一刻</text>
        <text class="scene-dot">配合</text>
      </view>
      <view class="scene-arrow">→</view>
      <view class="scene-item">
        <text class="scene-num">03</text>
        <text class="scene-name">饭桌上</text>
        <text class="scene-dot">危机</text>
      </view>
      <view class="scene-arrow">→</view>
      <view class="scene-item active">
        <text class="scene-num">⚡</text>
        <text class="scene-name">电梯揭晓</text>
        <text class="scene-dot">真相</text>
      </view>
    </view>

    <view class="version-row">
      <view class="version-card {{selectedVersion === 'basic' ? 'selected' : ''}}"
        bindtap="selectVersion" data-v="basic">
        <view class="version-tag free">免费</view>
        <view class="version-name">基础版</view>
        <view class="version-count">25道场景题</view>
      </view>
      <view class="version-card full-card {{selectedVersion === 'full' ? 'selected' : ''}}"
        bindtap="selectVersion" data-v="full">
        <view class="version-tag hot">热门</view>
        <view class="version-name">完整版</view>
        <view class="version-count">42道 · 含饭后危机关</view>
        <view class="version-price">¥4.9</view>
      </view>
    </view>

    <view class="start-btn" bindtap="startCouple">
      <text class="start-btn-text">发起通关</text>
      <text class="start-btn-sub">生成邀请，发给TA</text>
    </view>
    <view class="join-btn" bindtap="joinCouple">我收到了邀请，加入</view>
  </view>

  <!-- ═══ 等待 TA 加入 ═══ -->
  <view wx:if="{{pageState === 'waiting'}}" class="waiting">
    <view class="heartbeat-wrap">
      <text class="heartbeat-icon">💗</text>
      <view class="heartbeat-ring"></view>
    </view>
    <view class="waiting-title">邀请已发出</view>
    <view class="waiting-sub">TA还没进来\n先来预热一下</view>

    <view class="warmup-list">
      <view wx:for="{{warmupCards}}" wx:key="id" class="warmup-card">
        <view class="warmup-num">{{index + 1}}</view>
        <view class="warmup-body">
          <view class="warmup-title">{{item.title}}</view>
          <view class="warmup-punch">{{item.punchline}}</view>
        </view>
      </view>
    </view>

    <view class="waiting-footer">TA一进来，游戏立刻开始</view>
    <view class="share-btn" bindtap="shareInvite">再次分享邀请 →</view>

    <!-- 轻量顾问入口 -->
    <view class="waiting-cs" bindtap="openCS">
      <text>边等TA，顾问帮你看礼物单 →</text>
    </view>
  </view>

  <!-- ═══ 幕间过场（场景切换时显示） ═══ -->
  <view wx:if="{{pageState === 'scene_transition'}}" class="scene-transition">
    <view class="transition-stage">{{transitionStage}}</view>
    <view class="transition-title">{{transitionTitle}}</view>
    <view class="transition-desc">{{transitionDesc}}</view>
    <view class="transition-bar">
      <view class="transition-fill" style="width:{{transitionPct}}%"></view>
    </view>
  </view>

  <!-- ═══ 答题中 ═══ -->
  <view wx:if="{{pageState === 'playing'}}" class="playing">

    <!-- 顶部氛围条 -->
    <view class="play-header">
      <view class="play-stage-pill">{{currentGameQ.stage}}</view>
      <view class="play-progress-wrap">
        <view class="play-progress-bar">
          <view class="play-progress-fill" style="width:{{gameProgressPct}}%"></view>
        </view>
        <text class="play-progress-text">{{gameIndex + 1}}/{{gameTotalCount}}</text>
      </view>
      <view class="play-timer {{timerWarning ? 'timer-warn' : ''}}">
        <text class="timer-num">{{timerCount}}</text>
        <text class="timer-unit">s</text>
      </view>
    </view>

    <!-- 场景氛围提示 -->
    <view class="scene-context" wx:if="{{currentGameQ.sceneContext}}">
      <text class="scene-context-icon">🎬</text>
      <text class="scene-context-text">{{currentGameQ.sceneContext}}</text>
    </view>

    <!-- 题目 -->
    <view class="play-question">{{currentGameQ.text}}</view>
    <view class="play-hint" wx:if="{{currentGameQ.hint}}">· {{currentGameQ.hint}}</view>

    <!-- 暗号生成题 -->
    <view wx:if="{{currentGameQ.type === 'signal_gen'}}" class="signal-wrap">
      <view wx:if="{{!signal1}}" class="signal-empty" bindtap="generateSignals">
        <view class="signal-gen-btn">
          <text class="signal-gen-icon">🎲</text>
          <text class="signal-gen-text">生成你们的专属暗号</text>
        </view>
        <view class="signal-gen-sub">随机分配两个暗号，各自记住</view>
      </view>

      <view wx:if="{{signal1}}" class="signal-cards">
        <view class="signal-card">
          <view class="signal-num">暗号 1</view>
          <view class="signal-action">{{signal1.signal}}</view>
          <view class="signal-meaning">= {{signal1.meaning}}</view>
        </view>
        <view class="signal-card">
          <view class="signal-num">暗号 2</view>
          <view class="signal-action">{{signal2.signal}}</view>
          <view class="signal-meaning">= {{signal2.meaning}}</view>
        </view>
        <view class="signal-reshuffle" bindtap="reshuffleSignals">🔀 换一组</view>
      </view>
    </view>

    <!-- 普通单选题 -->
    <view wx:elif="{{currentGameQ.type !== 'open'}}" class="play-options">
      <view
        wx:for="{{currentGameQ.options}}"
        wx:key="index"
        class="play-option {{gameSelectedIdx === index ? 'selected' : ''}}"
        bindtap="selectGameOption"
        data-idx="{{index}}"
        style="animation-delay:{{index * 60}}ms"
      >
        <view class="play-opt-label">{{optionLabels[index]}}</view>
        <view class="play-opt-text">{{item.label}}</view>
      </view>
    </view>

    <!-- 开放题 -->
    <view wx:elif="{{currentGameQ.type === 'open'}}" class="play-open">
      <textarea
        class="open-input"
        placeholder="写下你真实的那句话……"
        placeholder-style="color:#5A5550"
        maxlength="60"
        bindinput="onGameOpenInput"
        value="{{gameOpenAnswer}}"
        auto-height
      />
      <view class="open-char-count">{{gameOpenAnswer.length}}/60</view>
    </view>

    <!-- 底部按钮 -->
    <view class="play-footer">
      <!-- 暗号题专属按钮 -->
      <view wx:if="{{currentGameQ.type === 'signal_gen'}}"
        class="play-confirm-btn {{signal1 ? 'active' : 'dim'}}"
        bindtap="confirmSignals">
        {{signalConfirmed ? '✓ 暗号已记住' : '记住了，开始通关'}}
      </view>
      <!-- 普通按钮 -->
      <view wx:else
        class="play-confirm-btn {{(gameSelectedIdx !== null || gameOpenAnswer.length > 0) ? 'active' : 'dim'}}"
        bindtap="confirmGameAnswer"
      >
        {{gameIndex + 1 < gameTotalCount - 1 ? '锁定答案' : '提交，等待TA'}}
      </view>
    </view>
  </view>

  <!-- ═══ 等待对方提交 ═══ -->
  <view wx:if="{{pageState === 'waitingResult'}}" class="waiting-result">
    <view class="wr-ring"></view>
    <view class="wr-title">等待TA提交</view>
    <view class="wr-sub">你们的答案被封存了\nTA提交后同时揭晓</view>
  </view>

  <!-- ═══ 电梯揭晓 ═══ -->
  <view wx:if="{{pageState === 'elevator'}}" class="elevator">
    <view class="elev-scene-desc">
      今晚，你们走出那扇门。<br/>
      电梯里只剩你们两个，灯亮了。
    </view>

    <view class="elev-screen">
      <view class="elev-side">
        <view class="elev-you">你说</view>
        <view class="elev-text {{elevatorAReady ? 'typed' : ''}}">{{elevatorADisplay}}</view>
      </view>
      <view class="elev-divider"></view>
      <view class="elev-side">
        <view class="elev-you">TA说</view>
        <view class="elev-text {{elevatorBReady ? 'typed' : ''}}">{{elevatorBDisplay}}</view>
      </view>
    </view>

    <view class="elev-verdict animate-fade-up" wx:if="{{elevatorBReady}}">
      这才是你们真实的样子。
    </view>

    <view class="btn-primary elev-result-btn" bindtap="goResultPage" wx:if="{{elevatorBReady}}">
      查看你们的默契报告 →
    </view>
  </view>

  <!-- 付费弹窗 -->
  <pay-modal
    show="{{showPayModal}}"
    product="{{payProduct}}"
    bindclose="onPayClose"
    bindpay="onPaySuccess"
  />
</view>
