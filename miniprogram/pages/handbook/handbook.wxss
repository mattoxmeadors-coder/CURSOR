/* 通关手册样式 */
.hb-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.hb-header {
  padding: calc(24rpx + env(safe-area-inset-top)) 40rpx 0;
  background: var(--color-bg);
  flex-shrink: 0;
}

.hb-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.hb-subtitle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

/* 分类筛选 */
.cat-scroll {
  width: 100%;
  margin-bottom: 24rpx;
}

.cat-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0 20rpx;
}

.cat-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.cat-chip.active {
  background: var(--color-gold-dim);
  border-color: var(--color-gold);
  color: var(--color-gold);
}

/* 手册列表 */
.hb-scroll {
  flex: 1;
  overflow: hidden;
}

.hb-list {
  padding: 0 32rpx 200rpx;
}

.hb-free-hint {
  padding: 20rpx 8rpx;
  font-size: 24rpx;
}

/* 卡片 */
.hb-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--color-radius-lg);
  margin-bottom: 16rpx;
  overflow: hidden;
  transition: border-color 0.2s;
}

.hb-card.expanded {
  border-color: rgba(201, 169, 110, 0.4);
}

.hb-card.locked .hb-card-title {
  /* 标题文字模糊，只显示轮廓，无法阅读 */
  color: transparent;
  text-shadow: 0 0 12rpx rgba(240,237,232,0.85);
  user-select: none;
}

.hb-card.locked .hb-card-cat {
  opacity: 0.5;
}

.hb-card-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
}

.hb-card-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text-tertiary);
  width: 52rpx;
  flex-shrink: 0;
  font-family: 'Courier New', monospace;
}

.hb-card-main {
  flex: 1;
  min-width: 0;
}

.hb-card-cat {
  font-size: 20rpx;
  color: var(--color-gold);
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.hb-card-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  line-height: 1.4;
}

.hb-card-badge {
  flex-shrink: 0;
}

.badge-free {
  font-size: 20rpx;
  color: #5ABF8A;
  background: rgba(90, 191, 138, 0.1);
  border: 1rpx solid rgba(90, 191, 138, 0.25);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.badge-lock {
  font-size: 28rpx;
}

.hb-card-arrow {
  flex-shrink: 0;
}

.arrow-down, .arrow-up {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  display: inline-block;
  transition: transform 0.3s;
}

.arrow-up {
  transform: rotate(90deg);
}

/* 展开内容 */
.hb-card-body {
  padding: 0 40rpx 40rpx;
  border-top: 1rpx solid var(--color-border);
}

.hb-answer {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.8;
  padding: 32rpx 0 24rpx;
  white-space: pre-line;
  font-weight: 500;
}

.hb-divider-gold {
  height: 1rpx;
  background: linear-gradient(90deg, var(--color-gold), transparent);
  margin: 8rpx 0 28rpx;
  opacity: 0.4;
}

.hb-reason-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.hb-reason {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  margin-bottom: 28rpx;
}

.hb-punchline {
  font-size: 26rpx;
  color: var(--color-gold);
  line-height: 1.6;
  padding: 20rpx 24rpx;
  background: var(--color-gold-dim);
  border-radius: var(--color-radius-md);
  font-style: italic;
  border-left: 4rpx solid var(--color-gold);
}

/* 锁定内容 */
.hb-locked-body {
  padding: 0 40rpx 40rpx;
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 32rpx;
}

.hb-locked-preview {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  filter: blur(4rpx);
}

.hb-locked-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.hb-unlock-btn {
  height: 80rpx;
  font-size: 28rpx;
}

/* 付费墙 */
.paywall-screen {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--color-radius-xl);
  padding: 60rpx 48rpx;
  margin: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.paywall-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 2;
  white-space: pre-line;
}

.paywall-btn {
  height: 96rpx;
  background: linear-gradient(135deg, #C9A96E, #E8C98A);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #0D0D0D;
}

.paywall-wecom {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 悬浮解锁按钮 */
.float-unlock {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  right: 40rpx;
  background: linear-gradient(135deg, #C9A96E, #E8C98A);
  border-radius: 48rpx;
  padding: 20rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0D0D0D;
  box-shadow: 0 8rpx 32rpx rgba(201, 169, 110, 0.4);
}

.float-price {
  font-size: 22rpx;
  opacity: 0.8;
}
