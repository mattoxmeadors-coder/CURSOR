<!-- 首页 -->
<view class="page-container">

  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-tag">见家长不翻车 · 备考工具</view>
    <view class="hero-title">
      <text>你真的</text>
      <text class="hero-title-gold">准备好了吗</text>
    </view>
    <view class="hero-subtitle">从礼物到酒桌，从进门到离场\n每一个翻车细节，今天提前测出来</view>
  </view>

  <!-- 核心入口：个人测评（免费） -->
  <view class="main-card" bindtap="startQuiz">
    <view class="main-card-label">
      <view class="tag tag-green">免费</view>
      <text class="main-card-subtitle">2分钟 · 25题</text>
    </view>
    <view class="main-card-title">翻车指数测评</view>
    <view class="main-card-desc">25道真实场景题，测出你最容易翻车的那个环节\n男女分轨，精准到你的具体情况</view>
    <view class="main-card-arrow">
      <text>测一测我会翻车吗</text>
      <text class="arrow-icon">→</text>
    </view>
  </view>

  <!-- 产品卡（不显示价格，点击后弹出说明） -->
  <view class="section-title">还有这些</view>
  <view class="product-grid">
    <view wx:for="{{products}}" wx:key="id"
      class="product-card {{item.id === 'full' ? 'product-card-highlight' : ''}}"
      bindtap="onProductTap" data-id="{{item.id}}">
      <view class="product-icon">{{item.icon}}</view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-desc">{{item.teaser}}</view>
      <view class="product-cta">了解 →</view>
    </view>
  </view>

  <!-- 数据信任带 -->
  <view class="trust-bar">
    <view class="trust-item">
      <text class="trust-num">47,218</text>
      <text class="trust-label">人测过</text>
    </view>
    <view class="trust-divider"></view>
    <view class="trust-item">
      <text class="trust-num">92%</text>
      <text class="trust-label">说有用</text>
    </view>
    <view class="trust-divider"></view>
    <view class="trust-item">
      <text class="trust-num">1,306</text>
      <text class="trust-label">对情侣做完</text>
    </view>
  </view>

  <!-- 真实好评卡 -->
  <view class="reviews-section">
    <view class="reviews-title">他们说</view>
    <scroll-view scroll-x class="reviews-scroll">
      <view class="reviews-list">
        <view wx:for="{{reviews}}" wx:key="id" class="review-card">
          <view class="review-header">
            <view class="review-avatar">{{item.avatar}}</view>
            <view class="review-meta">
              <view class="review-name">{{item.name}}</view>
              <view class="review-stars">★★★★★</view>
            </view>
          </view>
          <view class="review-text">{{item.text}}</view>
          <view class="review-tag">{{item.tag}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 今日快闪 -->
  <view class="daily-card" wx:if="{{dailyCard.title}}" bindtap="goHandbook">
    <view class="daily-header">
      <text class="daily-label">📍 今日快闪</text>
      <text class="daily-index">第{{dailyIndex}}条</text>
    </view>
    <view class="daily-title">{{dailyCard.title}}</view>
    <view class="daily-punchline">{{dailyCard.punchline}}</view>
    <view class="daily-cta">查看手册全部100条 →</view>
  </view>
  <!-- 骨架：快闪加载中 -->
  <view class="daily-card daily-skeleton" wx:else>
    <view class="skeleton-line w60"></view>
    <view class="skeleton-line w100 tall"></view>
    <view class="skeleton-line w80"></view>
  </view>

  <view class="footer"><text class="footer-text">部分功能付费 · 内容仅供参考</text></view>
  <view class="safe-bottom"></view>
</view>

<!-- ═══════════════════════════════════════════
     性别选择全屏遮罩（唯一前置步骤，一屏搞定）
     ═══════════════════════════════════════════ -->
<view wx:if="{{showGenderPicker}}" class="gender-overlay">

  <view class="gender-overlay-close" bindtap="closeGenderPicker">✕</view>

  <view class="gender-overlay-content">
    <view class="gender-overlay-title">你是</view>
    <view class="gender-overlay-sub">题库根据性别完全不同，先确认这一步</view>

    <view class="gender-big-row">
      <view class="gender-big-btn" bindtap="pickGender" data-val="male">
        <view class="gender-big-emoji">👨</view>
        <view class="gender-big-label">男生</view>
        <view class="gender-big-desc">证明我有资格带走她</view>
      </view>
      <view class="gender-big-btn" bindtap="pickGender" data-val="female">
        <view class="gender-big-emoji">👩</view>
        <view class="gender-big-label">女生</view>
        <view class="gender-big-desc">让他们真心接纳我</view>
      </view>
    </view>

    <view class="gender-overlay-hint">选完直接进题，不需要填其他信息</view>
  </view>

</view>

<!-- ═══════════════════════════════════════════
     产品价格说明弹层
     ═══════════════════════════════════════════ -->
<view wx:if="{{showPriceHint}}" class="price-mask" bindtap="closePriceHint">
  <view class="price-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-icon">{{priceHintProduct.icon}}</view>
    <view class="sheet-name">{{priceHintProduct.name}}</view>
    <view class="sheet-desc" wx:if="{{priceHintProduct.desc}}">{{priceHintProduct.desc}}</view>

    <view class="sheet-tiers">
      <view class="tier-item tier-free" wx:if="{{priceHintProduct.free}}" bindtap="goProductFree">
        <view class="tier-left">
          <view class="tier-badge free-badge">免费</view>
          <text class="tier-label">{{priceHintProduct.free}}</text>
        </view>
        <text class="tier-cta">先试试 →</text>
      </view>
      <view class="tier-item tier-paid" bindtap="goProductPaid">
        <view class="tier-left">
          <view class="tier-badge paid-badge">完整</view>
          <text class="tier-label">{{priceHintProduct.paid}}</text>
        </view>
        <text class="tier-cta">解锁 →</text>
      </view>
    </view>

    <view class="sheet-cancel" bindtap="closePriceHint">取消</view>
  </view>
</view>
