<!-- 首页 -->
<view class="page-container">

  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-tag">见家长 · 备考工具</view>
    <view class="hero-title">
      <text>这场面试</text>
      <text class="hero-title-gold">你准备好了吗</text>
    </view>
    <view class="hero-subtitle">从礼物到酒桌，从称呼到离场时机\n中国家庭见家长的每一个细节</view>
  </view>

  <!-- 核心入口：个人测评（免费） -->
  <view class="main-card" bindtap="startQuiz">
    <view class="main-card-label">
      <view class="tag tag-green">免费</view>
      <text class="main-card-subtitle">2分钟 · 25题</text>
    </view>
    <view class="main-card-title">个人准备度测评</view>
    <view class="main-card-desc">测出你今天真正的盲区\n男女分轨，精准到你的具体情况</view>
    <view class="main-card-arrow">
      <text>开始测评</text>
      <text class="arrow-icon">→</text>
    </view>
  </view>

  <!-- 产品卡（不显示价格，点击后弹出说明） -->
  <view class="section-title">还有这些</view>
  <view class="product-grid">
    <view wx:for="{{products}}" wx:key="id"
      class="product-card {{item.id === 'full' ? 'product-card-highlight' : ''}}"
      bindtap="onProductTap" data-id="{{item.id}}">
      <view class="product-icon">{{item.icon}}</view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-desc">{{item.teaser}}</view>
      <view class="product-cta">了解 →</view>
    </view>
  </view>

  <!-- 今日快闪 -->
  <view class="daily-card" wx:if="{{dailyCard.title}}">
    <view class="daily-header">
      <text class="daily-label">📍 今日快闪</text>
      <text class="daily-index">第{{dailyIndex}}条</text>
    </view>
    <view class="daily-title">{{dailyCard.title}}</view>
    <view class="daily-punchline">{{dailyCard.punchline}}</view>
    <view class="daily-cta" bindtap="goHandbook">查看手册全部100条 →</view>
  </view>

  <view class="footer"><text class="footer-text">部分功能付费 · 内容仅供参考</text></view>
  <view class="safe-bottom"></view>
</view>

<!-- ─── 产品价格说明弹层 ─── -->
<view class="mask {{showPriceHint ? 'show' : ''}}" catchtap="closePriceHint">
  <view class="bottom-sheet {{showPriceHint ? 'show' : ''}}" catchtap="">
    <view class="sheet-handle"></view>
    <view class="sheet-icon">{{priceHintProduct.icon}}</view>
    <view class="sheet-name">{{priceHintProduct.name}}</view>
    <view class="sheet-desc" wx:if="{{priceHintProduct.desc}}">{{priceHintProduct.desc}}</view>

    <view class="sheet-tiers">
      <view class="tier-item tier-free" wx:if="{{priceHintProduct.free}}" bindtap="goProductFree">
        <view class="tier-left">
          <view class="tier-badge free-badge">免费</view>
          <text class="tier-label">{{priceHintProduct.free}}</text>
        </view>
        <text class="tier-cta">先试试 →</text>
      </view>
      <view class="tier-item tier-paid" bindtap="goProductPaid">
        <view class="tier-left">
          <view class="tier-badge paid-badge">完整</view>
          <text class="tier-label">{{priceHintProduct.paid}}</text>
        </view>
        <text class="tier-cta">解锁 →</text>
      </view>
    </view>

    <view class="btn-ghost sheet-cancel" bindtap="closePriceHint">取消</view>
  </view>
</view>

<!-- ─── 4步身份选择弹层 ─── -->
<view class="mask {{showProfile ? 'show' : ''}}" catchtap="closeProfile">
  <view class="profile-sheet {{showProfile ? 'show' : ''}}" catchtap="">

    <!-- 进度条 -->
    <view class="steps-bar">
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this"
        class="step-dot {{profileStep >= item ? 'active' : ''}}">
      </view>
    </view>
    <view class="step-hint">{{profileStep}} / 4</view>

    <!-- 步骤1：性别 -->
    <block wx:if="{{profileStep === 1}}">
      <view class="step-title">你的性别</view>
      <view class="step-subtitle">决定整个题库路径</view>
      <view class="gender-row">
        <view class="gender-btn {{profile.gender === 'male' ? 'selected' : ''}}"
          bindtap="selectGender" data-val="male">
          <text class="gender-icon">👨</text>
          <text class="gender-label">男生</text>
        </view>
        <view class="gender-btn {{profile.gender === 'female' ? 'selected' : ''}}"
          bindtap="selectGender" data-val="female">
          <text class="gender-icon">👩</text>
          <text class="gender-label">女生</text>
        </view>
      </view>
    </block>

    <!-- 步骤2：地区 -->
    <block wx:if="{{profileStep === 2}}">
      <view class="step-title">对方父母所在地区</view>
      <view class="step-subtitle">按习俗强度分类</view>
      <scroll-view scroll-y style="flex:1;max-height:420rpx;">
        <view wx:for="{{regions}}" wx:key="value"
          class="region-item {{profile.region === item.value ? 'selected' : ''}}"
          bindtap="selectRegion" data-val="{{item.value}}">
          <text class="region-name">{{item.label}}</text>
          <text class="region-tag">{{item.tag}}</text>
        </view>
      </scroll-view>
    </block>

    <!-- 步骤3：见面性质 -->
    <block wx:if="{{profileStep === 3}}">
      <view class="step-title">这次见面的性质</view>
      <view class="step-subtitle">场景不同，题库侧重不同</view>
      <view class="occasion-list">
        <view wx:for="{{occasions}}" wx:key="value"
          class="occasion-item {{profile.occasion === item.value ? 'selected' : ''}}"
          bindtap="selectOccasion" data-val="{{item.value}}">
          <view class="occasion-name">{{item.label}}</view>
          <view class="occasion-desc">{{item.desc}}</view>
        </view>
      </view>
    </block>

    <!-- 步骤4：到场人员 -->
    <block wx:if="{{profileStep === 4}}">
      <view class="step-title">当天家里有哪些人</view>
      <view class="step-subtitle">多选，影响题库提示</view>
      <scroll-view scroll-y style="flex:1;max-height:420rpx;">
        <view wx:for="{{peopleOptions}}" wx:key="value"
          class="people-item {{peopleSelected[item.value] ? 'selected' : ''}}"
          bindtap="togglePeople" data-val="{{item.value}}">
          <view class="people-check {{peopleSelected[item.value] ? 'checked' : ''}}">
            <text wx:if="{{peopleSelected[item.value]}}">✓</text>
          </view>
          <view class="people-info">
            <text class="people-label">{{item.label}}</text>
            <text class="people-warn" wx:if="{{item.warn}}">⚠️ {{item.warn}}</text>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- 底部按钮 -->
    <view class="step-actions">
      <view class="btn-secondary step-back" wx:if="{{profileStep > 1}}" bindtap="prevStep">上一步</view>
      <view class="btn-primary step-next" bindtap="nextStep">
        {{profileStep === 4 ? '开始测评' : '下一步'}}
      </view>
    </view>

  </view>
</view>
