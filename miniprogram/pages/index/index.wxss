.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(122, 162, 255, 0.2), transparent 30%),
    linear-gradient(180deg, #08101a 0%, #09121f 45%, #08101a 100%);
  color: #f5f7fb;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.hero,
.panel {
  background: rgba(14, 26, 41, 0.88);
  border: 1rpx solid rgba(120, 168, 255, 0.18);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.24);
}

.hero {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #afc6ff;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 700;
  margin: 18rpx 0;
}

.hero-copy,
.section-copy,
.hint,
.bullet,
.plan-action,
.risk-reason,
.field-label,
.picker-value,
.textarea,
.input,
.entry-text,
.empty-copy {
  color: #9db0cd;
}

.hero-copy {
  font-size: 28rpx;
  line-height: 1.75;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(122, 162, 255, 0.1);
  border: 1rpx solid rgba(122, 162, 255, 0.18);
  color: #d7e4ff;
  font-size: 24rpx;
}

.panel {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.section-copy {
  display: block;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.mode-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.mode-btn {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(132, 170, 255, 0.18);
  background: rgba(255, 255, 255, 0.03);
  color: #f5f7fb;
  font-size: 26rpx;
  line-height: 1.3;
}

.mode-btn.active {
  background: linear-gradient(135deg, #7aa2ff, #9b7dff);
  color: #061224;
  border-color: transparent;
  font-weight: 700;
}

.field-group {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.picker,
.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 1rpx solid rgba(132, 170, 255, 0.18);
  background: rgba(7, 13, 23, 0.85);
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.picker-value.active,
.input.active,
.textarea.active {
  color: #f5f7fb;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(132, 170, 255, 0.18);
  background: rgba(255, 255, 255, 0.03);
  color: #dce8ff;
  font-size: 24rpx;
  line-height: 1.3;
}

.chip.active {
  background: rgba(85, 212, 184, 0.16);
  border-color: rgba(85, 212, 184, 0.34);
  color: #d9fff8;
}

.submit {
  width: 100%;
  border: 0;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #7aa2ff, #9b7dff);
  color: #061224;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.hero-result {
  display: block;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.risk-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.risk-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.risk-pill.high {
  background: rgba(255, 125, 125, 0.16);
  color: #ffd8d8;
}

.risk-pill.medium {
  background: rgba(255, 198, 92, 0.16);
  color: #ffe7b3;
}

.risk-pill.low {
  background: rgba(85, 212, 184, 0.16);
  color: #d9fff8;
}

.risk-card,
.plan-card,
.entry-card {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(132, 170, 255, 0.12);
  margin-bottom: 16rpx;
}

.risk-title,
.plan-phase,
.entry-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.risk-severity {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #afc6ff;
}

.bullet-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.bullet,
.plan-action,
.entry-text {
  display: block;
  font-size: 25rpx;
  line-height: 1.65;
}

.empty-state {
  padding: 12rpx 0 8rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.empty-copy {
  display: block;
  line-height: 1.7;
  margin-bottom: 18rpx;
}
