.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 60rpx;
  background:
    radial-gradient(circle at top, rgba(122, 162, 255, 0.18), transparent 28%),
    linear-gradient(180deg, #070f18 0%, #09111d 42%, #070f18 100%);
  color: #f5f7fb;
}

.hero-card,
.section-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(14, 22, 35, 0.97), rgba(10, 17, 27, 0.98));
  border: 1rpx solid rgba(130, 167, 255, 0.12);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 48rpx rgba(0, 0, 0, 0.28);
  margin-bottom: 24rpx;
}

.hero-card::after,
.section-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(122, 162, 255, 0.14), transparent 70%);
}

.hero-card {
  padding: 40rpx 30rpx 34rpx;
}

.section-card {
  padding: 28rpx 26rpx 30rpx;
}

.eyebrow {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #a8c1ff;
  text-transform: uppercase;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 58rpx;
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-copy,
.section-copy,
.preview-copy,
.mode-desc {
  color: #96a9c8;
  font-size: 26rpx;
  line-height: 1.72;
}

.hero-copy {
  margin-top: 20rpx;
}

.hero-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(122, 162, 255, 0.1);
  border: 1rpx solid rgba(122, 162, 255, 0.16);
  color: #dce8ff;
  font-size: 22rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-head-main {
  flex: 1;
}

.section-title,
.preview-title {
  font-size: 34rpx;
  line-height: 1.22;
  font-weight: 700;
}

.section-copy {
  margin-top: 10rpx;
}

.status-pill {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(85, 212, 184, 0.12);
  border: 1rpx solid rgba(85, 212, 184, 0.22);
  color: #b8fff0;
  font-size: 22rpx;
}

.mode-grid,
.preview-list,
.form-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.mode-card {
  padding: 22rpx 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(129, 167, 255, 0.1);
}

.mode-card.active {
  background: linear-gradient(135deg, rgba(122, 162, 255, 0.18), rgba(155, 125, 255, 0.16));
  border-color: rgba(155, 125, 255, 0.28);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.04);
}

.mode-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #eef4ff;
}

.mode-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.mode-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #cfe0ff;
  font-size: 20rpx;
}

.field-card {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(129, 167, 255, 0.1);
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #dfe8f8;
  font-size: 24rpx;
  font-weight: 600;
}

.field-help {
  display: block;
  margin-top: 10rpx;
  color: #8397b7;
  font-size: 21rpx;
  line-height: 1.55;
}

.picker,
.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(123, 160, 255, 0.14);
  background: rgba(6, 11, 18, 0.84);
  color: #f3f6fb;
  font-size: 28rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.picker-text {
  color: #f3f6fb;
}

.input::placeholder,
.textarea::placeholder {
  color: #60728f;
}

.textarea {
  min-height: 220rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(129, 167, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
  color: #dbe7fb;
  font-size: 24rpx;
  line-height: 1.35;
}

.chip-active {
  background: linear-gradient(135deg, rgba(85, 212, 184, 0.2), rgba(122, 162, 255, 0.16));
  border-color: rgba(85, 212, 184, 0.26);
  color: #effffc;
}

.submit-wrap {
  margin-bottom: 24rpx;
}

.primary-button {
  width: 100%;
  border: 0;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  background: linear-gradient(135deg, #7aa2ff, #a57aff);
  color: #061120;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 34rpx rgba(122, 162, 255, 0.28);
}

.submit-caption {
  margin-top: 14rpx;
  color: #879abc;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.preview-item {
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(129, 167, 255, 0.1);
}

.preview-title {
  font-size: 28rpx;
  font-weight: 700;
}

.preview-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
