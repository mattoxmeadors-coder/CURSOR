/* ─── 首页 ─── */

.hero {
  padding: 72rpx 48rpx 40rpx;
}

.hero-tag {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: var(--color-gold-dim);
  border: 1rpx solid rgba(201,169,110,0.3);
  border-radius: 32rpx;
  font-size: 22rpx;
  color: var(--color-gold);
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--color-text-primary);
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
}

.hero-title-gold { color: var(--color-gold); }

.hero-subtitle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  white-space: pre-line;
}

/* ─── 主测评卡 ─── */
.main-card {
  margin: 8rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1A1610, #201A0E);
  border: 1rpx solid rgba(201,169,110,0.25);
  border-radius: 40rpx;
  padding: 44rpx;
  position: relative;
  overflow: hidden;
}

.main-card::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(201,169,110,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.main-card-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-green {
  background: rgba(90,191,138,0.15);
  color: #5ABF8A;
  border: 1rpx solid rgba(90,191,138,0.3);
}

.main-card-subtitle { font-size: 24rpx; color: var(--color-text-tertiary); }

.main-card-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 14rpx;
}

.main-card-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  white-space: pre-line;
  margin-bottom: 36rpx;
}

.main-card-arrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-gold);
  border-radius: 40rpx;
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0D0D0D;
}

.arrow-icon { font-size: 32rpx; }

/* ─── 分区标题 ─── */
.section-title {
  padding: 0 48rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ─── 产品网格 ─── */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 0 32rpx 40rpx;
}

.product-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  padding: 36rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-height: 200rpx;
}

.product-card:active { opacity: 0.8; }
.product-card-highlight {
  background: linear-gradient(135deg, #1A1610, #201A0E);
  border-color: rgba(201,169,110,0.3);
}

.product-icon  { font-size: 48rpx; margin-bottom: 4rpx; }
.product-name  { font-size: 28rpx; font-weight: 600; color: var(--color-text-primary); }
.product-desc  { font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.5; flex: 1; }
.product-cta   { font-size: 22rpx; color: var(--color-gold); margin-top: 8rpx; }

/* ─── 今日快闪 ─── */
.daily-card {
  margin: 0 32rpx 40rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  padding: 40rpx;
}

.daily-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.daily-label  { font-size: 24rpx; color: var(--color-gold); font-weight: 500; }
.daily-index  { font-size: 22rpx; color: var(--color-text-tertiary); }
.daily-title  { font-size: 30rpx; font-weight: 600; color: var(--color-text-primary); line-height: 1.5; margin-bottom: 16rpx; }

.daily-punchline {
  font-size: 24rpx;
  color: var(--color-gold);
  line-height: 1.6;
  padding: 20rpx;
  background: var(--color-gold-dim);
  border-radius: 16rpx;
  border-left: 4rpx solid var(--color-gold);
  margin-bottom: 20rpx;
}

.daily-cta { font-size: 24rpx; color: var(--color-text-secondary); text-align: right; }

.footer { text-align: center; padding: 20rpx 0 12rpx; }
.footer-text { font-size: 22rpx; color: var(--color-text-tertiary); }

/* ─── 数据信任带 ─── */
.trust-bar {
  display: flex;
  align-items: center;
  margin: 0 32rpx 32rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--color-radius-xl);
  padding: 32rpx 0;
}

.trust-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.trust-num   { font-size: 36rpx; font-weight: 800; color: var(--color-gold); }
.trust-label { font-size: 22rpx; color: var(--color-text-tertiary); }

.trust-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-border);
}

/* ─── 好评模块 ─── */
.reviews-section {
  margin: 0 0 40rpx;
  padding: 0 32rpx;
}

.reviews-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.reviews-scroll { width: 100%; }

.reviews-list {
  display: flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.review-card {
  flex-shrink: 0;
  width: 480rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  padding: 32rpx;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.review-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--color-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.review-name  { font-size: 24rpx; color: var(--color-text-primary); font-weight: 500; }
.review-stars { font-size: 20rpx; color: #F0C040; margin-top: 2rpx; }

.review-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.review-tag {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: var(--color-surface-2);
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  display: inline-block;
}

/* 骨架屏 */
.daily-skeleton { min-height: 160rpx; justify-content: center; gap: 16rpx; }

@keyframes shimmer {
  0%   { opacity: 0.4; }
  50%  { opacity: 0.8; }
  100% { opacity: 0.4; }
}

.skeleton-line {
  height: 24rpx;
  background: var(--color-surface-2);
  border-radius: 12rpx;
  animation: shimmer 1.4s ease infinite;
}

.skeleton-line.tall { height: 80rpx; }
.skeleton-line.w60  { width: 60%; }
.skeleton-line.w80  { width: 80%; }
.skeleton-line.w100 { width: 100%; }

/* ═══════════════════════════════════════════
   性别选择全屏遮罩
   ═══════════════════════════════════════════ */
.gender-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 300;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.gender-overlay-close {
  position: absolute;
  top: calc(60rpx + env(safe-area-inset-top));
  right: 48rpx;
  font-size: 40rpx;
  color: rgba(255,255,255,0.4);
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gender-overlay-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.gender-overlay-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #F0EDE8;
  letter-spacing: 4rpx;
}

.gender-overlay-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.45);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.gender-big-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.gender-big-btn {
  flex: 1;
  background: #1A1A1A;
  border: 2rpx solid #2A2A2A;
  border-radius: 32rpx;
  padding: 56rpx 24rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transition: all 0.15s;
}

.gender-big-btn:active {
  background: #1A1610;
  border-color: #C9A96E;
  transform: scale(0.97);
}

.gender-big-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.gender-big-label {
  font-size: 36rpx;
  font-weight: 700;
  color: #F0EDE8;
}

.gender-big-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  text-align: center;
  line-height: 1.5;
}

.gender-overlay-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  margin-top: 8rpx;
}

/* ═══════════════════════════════════════════
   产品价格说明弹层
   ═══════════════════════════════════════════ */
.price-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.72);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.price-sheet {
  width: 100%;
  background: #161616;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 72rpx; height: 8rpx;
  background: #2A2A2A;
  border-radius: 4rpx;
  margin: 0 auto 36rpx;
}

.sheet-icon  { font-size: 72rpx; text-align: center; display: block; margin-bottom: 16rpx; }
.sheet-name  { font-size: 40rpx; font-weight: 700; color: #F0EDE8; text-align: center; margin-bottom: 12rpx; }
.sheet-desc  { font-size: 24rpx; color: #9A948A; text-align: center; line-height: 1.7; white-space: pre-line; margin-bottom: 32rpx; }

.sheet-tiers { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }

.tier-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  border: 2rpx solid #2A2A2A;
}

.tier-free { background: rgba(90,191,138,0.06); border-color: rgba(90,191,138,0.25); }
.tier-paid { background: rgba(201,169,110,0.08); border-color: rgba(201,169,110,0.25); }

.tier-left { display: flex; align-items: center; gap: 20rpx; }

.tier-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.free-badge { background: rgba(90,191,138,0.2); color: #5ABF8A; }
.paid-badge { background: rgba(201,169,110,0.2); color: #C9A96E; }
.tier-label { font-size: 28rpx; color: #F0EDE8; }
.tier-cta   { font-size: 26rpx; color: #C9A96E; font-weight: 600; }

.sheet-cancel {
  text-align: center;
  font-size: 26rpx;
  color: #5A5550;
  padding: 16rpx 0;
}
