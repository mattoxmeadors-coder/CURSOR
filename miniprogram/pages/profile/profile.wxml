<!-- 我的页面 -->
<view class="profile-page">
  <view class="profile-header">
    <view class="avatar-wrap">
      <text class="avatar-text">见</text>
    </view>
    <view class="user-info">
      <view class="user-name">备考用户</view>
      <view class="user-sub">部分功能付费</view>
    </view>
  </view>

  <!-- 已购产品 -->
  <view class="section">
    <view class="section-title-text">已购内容</view>
    <view class="purchased-list">
      <view wx:for="{{purchasedItems}}" wx:key="key" class="purchased-item">
        <text class="purchased-icon">{{item.icon}}</text>
        <view class="purchased-info">
          <text class="purchased-name">{{item.name}}</text>
          <text class="purchased-status">已解锁</text>
        </view>
      </view>
      <view wx:if="{{purchasedItems.length === 0}}" class="no-purchase">
        <text class="no-purchase-text">还没有已购内容</text>
      </view>
    </view>
  </view>

  <!-- 我的测评记录 -->
  <view class="section" wx:if="{{lastResult}}">
    <view class="section-title-text">最近测评</view>
    <view class="result-record" bindtap="viewLastResult">
      <view class="rr-score" style="color:{{lastResult.scoreColor}}">{{lastResult.score}}分</view>
      <view class="rr-info">
        <view class="rr-label">{{lastResult.gender === 'male' ? '男生路径' : '女生路径'}}</view>
        <view class="rr-time">{{lastResult.timeStr}}</view>
      </view>
      <view class="rr-arrow">›</view>
    </view>
  </view>

  <!-- 设置/功能入口 -->
  <view class="section">
    <view class="menu-item" bindtap="clearProfile">
      <text class="menu-icon">🔄</text>
      <text class="menu-text">重置画像（重新选择地区/场景）</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="showDisclaimer">
      <text class="menu-icon">📋</text>
      <text class="menu-text">使用说明与声明</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
