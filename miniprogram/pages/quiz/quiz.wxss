/* 测评页样式 */
.quiz-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.quiz-header {
  padding: 20rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--color-bg);
  position: sticky;
  top: 0;
  z-index: 10;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: var(--color-text-secondary);
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-track {
  flex: 1;
  height: 4rpx;
  background: var(--color-border);
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-gold), var(--color-gold-light));
  border-radius: 2rpx;
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

.stage-label {
  font-size: 22rpx;
  color: var(--color-gold);
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 主体 */
.quiz-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 40rpx 200rpx;
}

/* 题目区 */
.question-wrap {
  padding-top: 24rpx;
}

.q-number {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.q-text {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.5;
  margin-bottom: 20rpx;
  white-space: pre-line;
}

.q-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--color-radius-md);
  margin-bottom: 40rpx;
  border-left: 3rpx solid rgba(201,169,110,0.4);
}

.hint-dot {
  color: var(--color-gold);
  flex-shrink: 0;
  margin-top: 2rpx;
}

/* 选项 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: var(--color-radius-lg);
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  transition: all 0.25s;
  animation: fadeInUp 0.3s ease both;
}

.option-item:active {
  background: var(--color-surface-2);
  transform: scale(0.99);
}

.option-item.selected {
  border-color: var(--color-gold);
  background: var(--color-gold-dim);
}

.option-item.revealed {
  border-color: var(--color-gold);
  background: linear-gradient(135deg, var(--color-gold-dim), rgba(201,169,110,0.08));
}

.option-marker {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-surface-3);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.option-item.selected .option-marker {
  background: var(--color-gold);
  border-color: var(--color-gold);
  color: #0D0D0D;
}

.option-text {
  flex: 1;
  font-size: 29rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
}

.option-score {
  margin-top: 4rpx;
}

.score-dots {
  display: flex;
  gap: 6rpx;
}

.score-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-border);
  transition: background 0.2s;
}

.score-dot.lit {
  background: var(--color-gold);
}

/* 解析框 */
.analysis-box {
  margin-top: 40rpx;
  padding: 36rpx;
  background: var(--color-surface);
  border-radius: var(--color-radius-lg);
  border-left: 4rpx solid var(--color-gold);
}

.analysis-label {
  font-size: 22rpx;
  color: var(--color-gold);
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.analysis-text {
  font-size: 27rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  white-space: pre-line;
}

/* 开放题 */
.open-wrap {
  margin-top: 8rpx;
}

.open-input {
  width: 100%;
  min-height: 200rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--color-radius-lg);
  padding: 32rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.7;
  box-sizing: border-box;
}

.open-input:focus {
  border-color: var(--color-gold);
}

.open-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
}

/* 情绪引爆层 */
.kcard-wrap {
  padding-top: 24rpx;
}

.breakdown-wrap {
  padding-top: 60rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.breakdown-badge {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.breakdown-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 40rpx;
  padding: 0 24rpx;
}

.breakdown-body {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  line-height: 2;
  white-space: pre-line;
  text-align: center;
  padding: 0 16rpx;
  margin-bottom: 60rpx;
}

.breakdown-punch {
  display: block;
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.breakdown-btns {
  width: 100%;
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breakdown-buy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.breakdown-price {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 底部操作栏 */
.quiz-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--color-bg) 80%, transparent);
}

.btn-dim {
  opacity: 0.45;
}
