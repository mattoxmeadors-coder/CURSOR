<!-- 测评结果页 · 见家长不翻车 -->
<view class="result-page">
  <scroll-view scroll-y class="result-scroll">

    <!-- 屏1：分数冲击 -->
    <view class="screen screen-score">
      <view class="score-ring-wrap">
        <canvas type="2d" id="scoreCanvas" class="score-canvas" />
        <view class="score-center">
          <text class="score-number" style="color:{{scoreColor}}">{{displayScore}}</text>
          <text class="score-unit">分</text>
        </view>
      </view>
      <view class="score-question">你今天，准备好了吗？</view>
      <view class="score-label" style="color:{{scoreColor}}">{{scoreLabel}}</view>

      <view class="summary-row">
        <view class="summary-item">
          <text class="summary-num">{{blindSpots.length}}</text>
          <text class="summary-desc">个盲区</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="summary-num">{{score}}</text>
          <text class="summary-desc">满分100</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="summary-num">{{gender === 'male' ? '男生' : '女生'}}</text>
          <text class="summary-desc">专属路径</text>
        </view>
      </view>

      <!-- 顾问丁入（常显示，不依赖翻牌） -->
      <view class="cs-card-inline" bindtap="openCustomerService">
        <view class="cs-card-left">
          <view class="cs-avatar">顾</view>
          <view class="cs-text">
            <view class="cs-name">顾问 · 小不</view>
            <view class="cs-msg">看了你的测评，有一句话想告诉你 →</view>
          </view>
        </view>
        <view class="cs-arrow">›</view>
      </view>
    </view>

    <!-- 屏2：三大盲区翻牌 -->
    <view class="screen screen-blindspots">
      <view class="section-header">
        <text class="section-tag">你的盲区</text>
        <text class="section-title">这几件事可能会翻车</text>
      </view>

      <view wx:if="{{blindSpots.length === 0}}" class="no-blindspot">
        <text class="no-blindspot-icon">🎯</text>
        <text class="no-blindspot-text">没有发现明显盲区，准备相当充分</text>
        <!-- 无盲区时也展示企微 -->
        <view class="cs-gift-card" bindtap="openCustomerService">
          <text class="cs-gift-icon">🎁</text>
          <view class="cs-gift-text">
            <view class="cs-gift-title">你的备考质量超过80%的人</view>
            <view class="cs-gift-sub">顾问为你准备了一套礼物清单，点这里领取</view>
          </view>
        </view>
      </view>

      <view wx:for="{{blindSpots}}" wx:key="index"
        class="blindspot-card {{flippedCards[index] ? 'flipped' : ''}}"
        bindtap="flipCard" data-idx="{{index}}">
        <view class="card-front">
          <view class="card-front-icon">?</view>
          <view class="card-front-text">{{item.stage}} · 盲区 {{index + 1}}</view>
          <view class="card-front-hint">点击翻开</view>
        </view>
        <view class="card-back">
          <view class="card-back-q">{{item.question}}…</view>
          <view class="card-back-analysis">{{item.analysis}}</view>
        </view>
      </view>

      <!-- 翻牌企微（翻了至少一张才出现，降低门槛） -->
      <view wx:if="{{flippedCount > 0}}" class="wecom-hook animate-fade-up">
        <view class="wecom-hook-inner">
          <view class="wecom-title">顾问有一句话想告诉你</view>
          <view class="wecom-body">你的盲区是见家长当天最容易触发的那种——我给你准备了3件不踩雷的礼物方案，还有一句你最需要听的话。</view>
          <view class="wecom-btn-primary" bindtap="openCustomerService">
            <text>点这里，一对一告诉我</text>
            <text class="wecom-btn-sub">打开后发「盲区」即可</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 屏3：礼品推荐 + 企微 -->
    <view class="screen screen-gift">
      <view class="gift-card">
        <view class="gift-header">
          <text class="gift-region">{{regionLabel}}的家庭</text>
          <text class="gift-question">带什么礼物最不会踩雷？</text>
        </view>
        <view class="gift-body">顾问会根据你选的地区和家庭类型，推荐3件不踩雷的礼物——含理由和预算范围。</view>
        <view class="gift-btn" bindtap="openCustomerService">看顾问给我选 →</view>
      </view>
    </view>

    <!-- 屏4：情侣通关入口 -->
    <view class="screen screen-couple">
      <view class="couple-invite">
        <view class="couple-invite-title">找出你们两个没对上的地方</view>
        <view class="couple-invite-desc">情侣通关 · 42道真实场景题\n你答你的，TA答TA的，最后一起揭晓</view>
        <view class="btn-primary" bindtap="goCouple">开始情侣通关 →</view>
        <view class="couple-price-hint">基础版免费发起 · 完整版 ¥4.9</view>
      </view>
    </view>

    <view class="redo-area">
      <view class="btn-ghost" bindtap="redoQuiz">重新测评</view>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>

  <pay-modal
    show="{{showPayModal}}"
    product="{{payProduct}}"
    bindclose="onPayClose"
    bindpay="onPaySuccess"
  />
</view>
