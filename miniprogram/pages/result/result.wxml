<view class="page" wx:if="{{result}}">
  <view class="hero-card">
    <view class="eyebrow">你的结果</view>
    <view class="hero-title">{{result.heroTitle}}</view>
    <view class="hero-summary">{{result.heroSummary}}</view>
    <view class="hero-meta">
      <view class="pill pill-{{result.riskLevel}}">{{riskTone[result.riskLevel]}}</view>
      <view class="pill pill-ghost">{{result.personaLabel}}</view>
      <view class="pill pill-ghost">风险分 {{result.riskScore}}</view>
    </view>
  </view>

  <view class="overview-card">
    <view class="section-title">一眼看懂这次局面</view>
    <view class="overview-item">
      <view class="overview-label">当前画像</view>
      <view class="overview-value">{{result.personaLabel}}</view>
    </view>
    <view class="overview-item">
      <view class="overview-label">风险强度</view>
      <view class="overview-value">{{riskTone[result.riskLevel]}}</view>
    </view>
    <view class="overview-item">
      <view class="overview-label">最该先稳住</view>
      <view class="overview-value">{{topRiskTitle}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">这次最容易翻车的 3 个瞬间</view>
    <block wx:for="{{result.topRisks}}" wx:key="title">
      <view class="risk-item">
        <view class="risk-head">
          <view class="risk-title">{{index + 1}}. {{item.title}}</view>
          <view class="risk-badge risk-badge-{{item.severity}}">{{riskTone[item.severity]}}</view>
        </view>
        <view class="risk-reason">{{item.reason}}</view>
      </view>
    </block>
  </view>

  <view class="section-card">
    <view class="section-title">当天作战方案</view>
    <block wx:for="{{result.battlePlan}}" wx:key="phase">
      <view class="phase-card">
        <view class="phase-title">{{item.phase}}</view>
        <block wx:for="{{item.actions}}" wx:key="*this">
          <view class="bullet">• {{item}}</view>
        </block>
      </view>
    </block>
  </view>

  <view class="action-card">
    <view class="section-title">你和 TA 现在最该统一什么</view>
    <view class="section-summary">{{result.alignmentSummary}}</view>
    <block wx:for="{{result.alignmentActions}}" wx:key="*this">
      <view class="bullet">• {{item}}</view>
    </block>
  </view>

  <view class="section-card">
    <view class="section-title">礼物建议</view>
    <view class="gift-title">{{result.giftPlan.title}}</view>
    <view class="section-summary">{{result.giftPlan.summary}}</view>
    <block wx:for="{{result.giftPlan.items}}" wx:key="*this">
      <view class="bullet">• {{item}}</view>
    </block>
  </view>

  <view class="section-card">
    <view class="section-title">你现在马上该补的知识卡</view>
    <block wx:for="{{result.knowledgeRecommendations}}" wx:key="title">
      <view class="knowledge-item">
        <view class="knowledge-title">{{item.title}}</view>
        <block wx:for="{{item.bullets}}" wx:key="*this">
          <view class="bullet">• {{item}}</view>
        </block>
      </view>
    </block>
  </view>

  <view class="section-card">
    <view class="section-title">模拟演练</view>
    <view class="section-summary">把下面 3 个问题先和自己练顺，再去现场。</view>
    <block wx:for="{{result.simulationPrompts}}" wx:key="*this">
      <view class="rehearsal-item">{{index + 1}}. {{item}}</view>
    </block>
  </view>

  <button class="back-btn" bindtap="handleBack">返回继续调整</button>
</view>
