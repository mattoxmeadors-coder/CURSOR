.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    radial-gradient(circle at top, rgba(122, 162, 255, 0.18), transparent 32%),
    linear-gradient(180deg, #07101b 0%, #0b1525 100%);
  color: #f4f7fb;
}

.hero-card,
.overview-card,
.section-card,
.action-card,
.empty-card {
  position: relative;
  overflow: hidden;
  background: rgba(12, 22, 36, 0.92);
  border: 1rpx solid rgba(128, 171, 255, 0.14);
  border-radius: 32rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 20rpx 46rpx rgba(0, 0, 0, 0.24);
  margin-bottom: 20rpx;
}

.hero-card::after,
.overview-card::after,
.section-card::after,
.action-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(122, 162, 255, 0.08), transparent 42%);
  pointer-events: none;
}

.eyebrow {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: #aec7ff;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 700;
}

.hero-summary {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: #9aaed0;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.pill-high {
  background: rgba(255, 104, 104, 0.16);
  color: #ffc0c0;
}

.pill-medium {
  background: rgba(255, 198, 92, 0.16);
  color: #ffe3a0;
}

.pill-low {
  background: rgba(82, 229, 160, 0.16);
  color: #b8ffe2;
}

.pill-neutral {
  background: rgba(122, 162, 255, 0.14);
  color: #d7e4ff;
}

.overview-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.overview-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(128, 171, 255, 0.1);
}

.overview-label {
  display: block;
  font-size: 22rpx;
  color: #89a0c2;
}

.overview-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.section-summary {
  display: block;
  margin-bottom: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #9aaed0;
}

.action-card {
  background: linear-gradient(180deg, rgba(18, 28, 48, 0.96), rgba(12, 22, 36, 0.92));
}

.risk-item,
.phase-item,
.knowledge-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(128, 171, 255, 0.1);
}

.risk-item:first-child,
.phase-item:first-child,
.knowledge-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.risk-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.risk-title,
.phase-title,
.knowledge-title {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
}

.risk-level {
  flex-shrink: 0;
  font-size: 22rpx;
  margin-top: 2rpx;
}

.risk-level.high {
  color: #ffb6b6;
}

.risk-level.medium {
  color: #ffe0a2;
}

.risk-level.low {
  color: #b8ffe2;
}

.risk-reason,
.phase-line,
.action-line,
.knowledge-line {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #9aaed0;
}

.knowledge-title {
  margin-bottom: 10rpx;
}

.empty-card {
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.72;
  color: #9aaed0;
}

.back-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 22rpx;
  border: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #7aa2ff, #9b7dff);
  color: #07111c;
  font-size: 30rpx;
  font-weight: 700;
}
