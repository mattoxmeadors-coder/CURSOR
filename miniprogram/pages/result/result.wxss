.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(122, 162, 255, 0.18), transparent 35%),
    linear-gradient(180deg, #08101a 0%, #0b1524 100%);
  color: #f5f7fb;
  padding: 24rpx;
}

.hero-card,
.section-card,
.pack-card,
.empty-card {
  background: rgba(14, 26, 41, 0.92);
  border: 1rpx solid rgba(120, 168, 255, 0.18);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 20rpx;
}

.eyebrow {
  font-size: 22rpx;
  color: #afc6ff;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  display: block;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 700;
  display: block;
}

.hero-summary {
  margin-top: 18rpx;
  color: #9db0cd;
  line-height: 1.7;
  font-size: 28rpx;
}

.pill-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.pill-high {
  background: rgba(255, 112, 112, 0.14);
  color: #ff9a9a;
}

.pill-medium {
  background: rgba(255, 193, 92, 0.14);
  color: #ffd48a;
}

.pill-low {
  background: rgba(85, 212, 184, 0.14);
  color: #aef6e6;
}

.pill-score {
  background: rgba(122, 162, 255, 0.14);
  color: #d6e4ff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  display: block;
}

.risk-item,
.phase-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(120, 168, 255, 0.12);
}

.risk-item:first-child,
.phase-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.risk-title-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 700;
}

.risk-badge {
  font-size: 22rpx;
  color: #afc6ff;
}

.risk-reason,
.action-item,
.bullet,
.pack-text,
.empty-text {
  color: #9db0cd;
  font-size: 26rpx;
  line-height: 1.7;
}

.phase-name,
.pack-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  display: block;
}

.action-item,
.bullet {
  display: block;
  margin-top: 8rpx;
}

.secondary-title {
  font-size: 26rpx;
  color: #d9e4fb;
  margin-bottom: 10rpx;
  display: block;
}

.pack-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.back-btn {
  width: 100%;
  border: 0;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7aa2ff, #9b7dff);
  color: #07111d;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx;
  margin-top: 12rpx;
}
